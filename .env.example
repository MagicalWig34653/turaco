APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://turaco:turaco-dev@localhost:5432/turaco?sslmode=disable
# Tests use a separate database so they never touch development data.
TEST_DATABASE_URL=postgres://turaco:turaco-dev@localhost:5432/turaco_test?sslmode=disable
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=turaco-dev
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_PATH_STYLE=true
LOG_LEVEL=debug
SESSION_COOKIE_SECURE=false

# Attachments (ADR-0037), optional. Create a key once: mkdir -p ~/.config/turaco && openssl rand -hex 32 > ~/.config/turaco/storage-master.key
# STORAGE_DRIVER=filesystem
# STORAGE_PATH=/absolute/path/to/turaco-files
# STORAGE_MASTER_KEY_FILE=/Users/you/.config/turaco/storage-master.key
# CLAMAV_ADDRESS=localhost:3310
